# Solo servidor. Copiar a .env.local y completar con datos propios.
# Nunca usar NEXT_PUBLIC_ ni guardar estas variables en site-content.ts.
RESEND_API_KEY=
# Remitente autorizado en Resend: dirección sola o "Velour Studio <dirección>".
# El dominio debe estar verificado. Ver content/RESEND-SETUP.md para pruebas sin dominio.
FROM_EMAIL=
# Buzón privado donde recibir todas las consultas.
CONTACT_EMAIL=
