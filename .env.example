# Solo servidor. Copiar a .env.local y completar con datos propios.
# Nunca usar NEXT_PUBLIC_ para estas variables ni guardar la API key en site-content.ts.
RESEND_API_KEY=
# Email remitente de un dominio verificado en Resend, sin nombre ni corchetes.
RESEND_FROM_EMAIL=
# Buzón receptor privado. Tiene prioridad sobre businessConfig.formRecipientEmail.
FORM_RECIPIENT_EMAIL=
