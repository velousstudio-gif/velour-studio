# Solo servidor. Copiar a .env.local y completar con datos propios.
# Nunca usar NEXT_PUBLIC_ ni guardar estas variables en site-content.ts.
RESEND_API_KEY=
# Remitente autorizado en Resend: dirección sola o "Velour Studio <dirección>".
# El dominio debe estar verificado. Ver content/RESEND-SETUP.md para pruebas sin dominio.
FROM_EMAIL=
# Buzón privado donde recibir todas las consultas.
CONTACT_EMAIL=

# ── Leads y CRM (Fase 2) ─────────────────────────────────────────────────────────────────────
# LEAD_STORE elige dónde se guardan los leads y cómo se autentica el CRM:
#   supabase → PRODUCCIÓN. Postgres + Supabase Auth (ver supabase/README.md).
#   pglite   → solo desarrollo/pruebas: Postgres embebido local con la misma migración (carpeta .data/). CRM completo.
#   file     → solo desarrollo/pruebas: JSON en .data/leads.json (sin CRM).
#   (vacío)  → sin base: el formulario solo envía el email (comportamiento original).
# pglite y file se bloquean solos en producción y en Vercel.
LEAD_STORE=
LEAD_STORE_PATH=

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el código.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Solo con LEAD_STORE=pglite: usuarios locales de prueba (se crean al iniciar). Elegí tus propias claves.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_COLLAB_EMAIL=
DEV_COLLAB_PASSWORD=
